# The data is a verbatim drop-in of OK1RR's set and must stay byte-identical
# to what upstream shipped -- some files are CRLF, some LF, and that varies
# between releases. Never let git normalise them: the parsers ignore every
# byte below 32, so the mixture is harmless, but a rewritten file would no
# longer match upstream and every refresh would show spurious changes.
data/** -text

# Payload for cqrlog-cty.tar.gz -- LF like upstream's README, on every platform.
packaging/cty/README text eol=lf
